{
  "name": "@cortiqa/sdk",
  "version": "0.1.1",
  "description": "Official TypeScript & JavaScript client library for Cortiqa AI & Falin Foundation Models",
  "keywords": [
    "cortiqa",
    "ai",
    "llm",
    "falin",
    "sdk",
    "anthropic",
    "openai",
    "agentic-ai",
    "nextjs"
  ],
  "author": "Cortiqa AI Team <team@cortiqa.co>",
  "license": "MIT",
  "homepage": "https://cortiqa.co",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cortiqa-ai/cortiqa-sdk-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/cortiqa-ai/cortiqa-sdk-typescript/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "node --test dist/**/*.test.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "prettier": "^3.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
